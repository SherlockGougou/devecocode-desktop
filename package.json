{
  "name": "deveco-code-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "DevEco Code 的 macOS 桌面外壳：驱动本机 deveco CLI，复用官方 Web UI，补齐系统通知",
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "build:debug": "tauri build --debug",
    "icon": "tauri icon src-tauri/icons/source.png",
    "selftest": "cargo run --manifest-path src-tauri/Cargo.toml --bin deveco-selftest",
    "test": "cargo test --manifest-path src-tauri/Cargo.toml"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4"
  }
}
